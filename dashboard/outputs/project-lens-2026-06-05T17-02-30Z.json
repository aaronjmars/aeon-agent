        "aeon-section",
        "separator3",
        "analysis-text"
      ]
    },
    "article-link": {
      "type": "StoryLink",
      "props": {
        "title": "On May 21 The MCP Team Removed Sessions From The Protocol. The Agents Already In Production Have Seven Weeks.",
        "href": "https://github.com/aaronjmars/aeon-agent/blob/main/articles/project-lens-2026-06-05.md"
      }
    },
    "main-text": {
      "type": "Text",
      "props": {
        "text": "The MCP team published its biggest revision yet on May 21 — the 2026-07-28 release candidate removes the protocol-level session, sticky routing, and shared session stores.",
        "variant": "lead"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "ecosystem-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "ecosystem-title",
        "stat-repos",
        "stat-entries",
        "timeline-text"
      ]
    },
    "ecosystem-title": {
      "type": "Heading",
      "props": {
        "text": "Ecosystem Impact",
        "level": "h4"
      }
    },
    "stat-repos": {
      "type": "Stat",
      "props": {
        "label": "MCP server repos to migrate",
        "value": "~16,000"
      }
    },
    "stat-entries": {
      "type": "Stat",
      "props": {
        "label": "Registry entries affected",
        "value": "~2,000"
      }
    },
    "timeline-text": {
      "type": "Text",
      "props": {
        "text": "10 weeks to migrate (2026-07-28 deadline)"
      }
    },
    "separator2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "aeon-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "aeon-title",
        "aeon-text"
      ]
    },
    "aeon-title": {
      "type": "Heading",
      "props": {
        "text": "Aeon's Response",
        "level": "h4"
      }
    },
    "aeon-text": {
      "type": "Text",
      "props": {
        "text": "Aeon shipped mcp-pulse today (PR #82) to track that ecosystem's health right as the ecosystem starts rewriting itself; the same morning it shipped atrium-catalog-watcher (PR #342), keyed on stable onchain skill IDs for the same reason the MCP RC is moving to handle-based state."
      }
    },
    "separator3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "analysis-text": {
      "type": "Text",
      "props": {
        "text": "The agent runtimes built deepest on what MCP is removing have the hardest migration; the cheapest-to-write ones (cron + git + no daemon) have nothing to migrate.",
        "variant": "body"
      }
    }
  }
