      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "date_badge",
        "separator_1",
        "problem_section",
        "separator_2",
        "context_section",
        "separator_3",
        "changes_section",
        "separator_4",
        "impact_section",
        "separator_5",
        "pr_section",
        "separator_6",
        "future_section"
      ]
    },
    "date_badge": {
      "type": "Badge",
      "props": {
        "text": "2026-06-04",
        "variant": "secondary"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {}
    },
    "problem_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "problem_heading",
        "problem_detail",
        "problem_solution"
      ]
    },
    "problem_heading": {
      "type": "Heading",
      "props": {
        "text": "repo-article shell substitution fix",
        "level": "h2"
      }
    },
    "problem_detail": {
      "type": "Text",
      "props": {
        "text": "skills/repo-article/SKILL.md step 1 was using $(date -u -d '7 days ago' ...) to compute the commit-history cutoff. The runner hook blocks all $(...) shell substitution, so every daily 16:00 UTC run had to improvise around it.",
        "variant": "body"
      }
    },
    "problem_solution": {
      "type": "Text",
      "props": {
        "text": "Solution: Swapped for a literal SINCE=YYYY-MM-DDT00:00:00Z that the agent computes from ${today} minus 7 days at write time.",
        "variant": "lead"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {}
    },
    "context_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "context_heading",
        "context_detail",
        "context_history"
      ]
    },
    "context_heading": {
      "type": "Heading",
      "props": {
        "text": "Context: Runner-shell-guard cleanup wave",
        "level": "h3"
      }
    },
    "context_detail": {
      "type": "Text",
      "props": {
        "text": "Continuation of cleanup wave. The Jun-02 self-improve run (PR #77, repo-pulse) explicitly listed three skills with this anti-pattern as \"left for future runs.\" repo-article picked because daily cadence is the highest-leverage of the three and the substitution is a single line — smallest-effort next item.",
        "variant": "body"
      }
    },
    "context_history": {
      "type": "Text",
      "props": {
        "text": "Same fix class as PRs #63 (weekly-shiplog), #67 (push-recap), #71 (heartbeat), #77 (repo-pulse).",
        "variant": "caption"
      }
    },
    "separator_3": {
      "type": "Separator",
      "props": {}
    },
    "changes_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "changes_heading",
        "change_1",
        "change_2"
      ]
    },
    "changes_heading": {
      "type": "Heading",
      "props": {
        "text": "What Changed",
        "level": "h3"
      }
    },
    "change_1": {
      "type": "Text",
      "props": {
        "text": "• skills/repo-article/SKILL.md step 1: inline since=\"$(date ...)\" → SINCE=YYYY-MM-DDT00:00:00Z literal + paragraph citing prior PRs so future cleanup can't drop the constraint.",
        "variant": "body"
      }
    },
    "change_2": {
      "type": "Text",
      "props": {
        "text": "• memory/MEMORY.md: new Skills Built row; two remaining unfixed sites (repo-actions:29 and star-momentum-alert:69) surfaced again for future rounds.",
        "variant": "body"
      }
    },
    "separator_4": {
      "type": "Separator",
      "props": {}
    },
    "impact_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "impact_heading",
        "impact_detail"
      ]
    },
    "impact_heading": {
      "type": "Heading",
      "props": {
        "text": "Impact",
        "level": "h3"
      }
    },
    "impact_detail": {
      "type": "Text",
      "props": {
        "text": "Removes daily improvisation friction on repo-article — the cutoff is now declarative and reproducible across runs instead of fighting the hook. Article remains a 7-day retrospective; the slightly wider window (7d–7d+16h) is absorbed by the prose framing.",
        "variant": "body"
      }
    },
