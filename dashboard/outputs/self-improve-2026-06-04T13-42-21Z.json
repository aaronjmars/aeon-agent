      }
    },
    "pr_link": {
      "type": "StoryLink",
      "props": {
        "title": "PR #81: repo-article runner-shell-guard fix",
        "href": "https://github.com/aaronjmars/aeon-agent/pull/81",
        "source": "GitHub"
      }
    },
    "separator_6": {
      "type": "Separator",
