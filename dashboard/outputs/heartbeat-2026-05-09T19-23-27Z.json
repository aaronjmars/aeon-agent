{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "heartbeat",
        "description": "PR stalled >24h"
      },
      "children": [
        "stalled-alert",
        "main-stack"
      ]
    },
    "stalled-alert": {
      "type": "Alert",
      "props": {
        "message": "PR stalled >24h",
        "type": "warning"
      }
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "pr-story",
        "pr-metadata",
        "description-section",
        "review-status"
      ]
    },
    "pr-story": {
      "type": "StoryLink",
      "props": {
        "title": "aeon-agent #33",
        "href": "https://github.com/aaronjmars/aeon-agent/pull/33",
        "source": "GitHub"
      }
    },
    "pr-metadata": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "branch-badge",
        "timeline-info"
      ]
    },
    "branch-badge": {
      "type": "Badge",
      "props": {
        "text": "improve/xai-prefetch-truncation-warning"
      }
    },
    "timeline-info": {
      "type": "Text",
      "props": {
        "text": "Opened May-8 13:27Z, now ~30h open",
        "variant": "muted"
      }
    },
    "description-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "description-text"
      ]
    },
    "description-text": {
      "type": "Text",
      "props": {
        "text": "Adds a ::warning:: annotation to prefetch-xai.sh when output_tokens approaches the 16384 cap — a low-risk observability fix.",
        "variant": "body"
      }
    },
    "review-status": {
      "type": "Text",
      "props": {
        "text": "No review activity yet",
        "variant": "muted"
      }
    }
  }
}
