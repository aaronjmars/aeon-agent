{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Repo Pulse"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "repo_name",
        "date_badge",
        "sep1",
        "stats_stack",
        "sep2",
        "stargazers_stack"
      ]
    },
    "repo_name": {
      "type": "Heading",
      "props": {
        "text": "aaronjmars/minitor",
        "level": "h2"
      },
      "children": []
    },
    "date_badge": {
      "type": "Badge",
      "props": {
        "text": "2026-05-08",
        "variant": "secondary"
      },
      "children": []
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "stats_stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat_stars",
        "stat_forks"
