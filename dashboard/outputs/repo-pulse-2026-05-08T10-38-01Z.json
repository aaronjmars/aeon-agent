    "stargazers_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "stargazers_heading",
        "stargazer_1"
      ]
    },
    "stargazers_heading": {
      "type": "Heading",
      "props": {
        "text": "New stargazers",
        "level": "h3"
      },
      "children": []
