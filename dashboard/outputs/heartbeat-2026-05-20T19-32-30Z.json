{
  "root": "card_heartbeat",
  "state": {},
  "elements": {
    "card_heartbeat": {
      "type": "Card",
      "props": {
        "title": "Heartbeat 2026-05-20"
      },
      "children": [
        "status_success",
        "separator_1",
        "action_alert",
        "separator_2",
        "context_stack"
      ]
    },
    "status_success": {
      "type": "Alert",
      "props": {
        "type": "success",
        "message": "All 15 scheduled skills ran clean"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "action_alert": {
      "type": "Alert",
      "props": {
        "type": "warning",
        "title": "Action Needed",
        "message": "show-hn-draft is still disabled (workflow_dispatch)"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "context_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "pr_section",
        "milestone_section",
        "window_section",
        "cta_text"
      ]
    },
    "pr_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "pr_label",
        "pr_link"
      ]
    },
    "pr_label": {
      "type": "Text",
      "props": {
        "text": "Related PR:",
        "variant": "caption"
      }
    },
    "pr_link": {
      "type": "Link",
      "props": {
        "label": "PR #151 (May 1)",
        "href": "https://github.com/aeon-agent/aeon-agent/pull/151"
      }
    },
    "milestone_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "milestone_label",
        "star_stat"
      ]
    },
    "milestone_label": {
      "type": "Text",
      "props": {
        "text": "Milestone crossed today:",
        "variant": "caption"
      }
    },
    "star_stat": {
      "type": "Stat",
      "props": {
        "label": "Organic Stars",
        "value": "400"
      }
    },
    "window_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "window_title",
        "conditions_stack"
      ]
    },
    "window_title": {
      "type": "Heading",
      "props": {
        "text": "Show HN Window",
        "level": "h3"
      }
    },
    "conditions_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "window_open",
        "asset_ready",
        "milestone_fresh",
        "momentum_real"
      ]
    },
    "window_open": {
      "type": "Badge",
      "props": {
        "text": "Window open",
        "variant": "secondary"
      }
    },
    "asset_ready": {
      "type": "Badge",
      "props": {
        "text": "Asset pack ready",
        "variant": "secondary"
      }
    },
    "milestone_fresh": {
      "type": "Badge",
      "props": {
        "text": "Milestone fresh",
        "variant": "secondary"
      }
    },
    "momentum_real": {
      "type": "Badge",
      "props": {
        "text": "Momentum real",
        "variant": "secondary"
      }
    },
    "cta_text": {
      "type": "Text",
      "props": {
        "text": "Dispatch when ready.",
        "variant": "lead"
      }
    }
  }
}
