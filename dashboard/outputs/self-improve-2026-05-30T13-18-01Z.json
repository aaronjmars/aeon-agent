        "whyHeading",
        "whyText"
      ]
    },
    "whyHeading": {
      "type": "Heading",
      "props": {
        "text": "Why",
        "level": "h3"
      }
    },
    "whyText": {
      "type": "Text",
      "props": {
        "text": "The runner hook blocks shell command/variable expansion with \"Contains simple_expansion\" — identical constraint PR #63 fixed in weekly-shiplog (May 26) and PR #67 fixed in push-recap (May 28). heartbeat runs daily at 19:00 UTC; on every run the agent had to improvise the cutoff. Picked over the four other enabled skills with the same anti-pattern (repo-pulse:27, repo-article:26, repo-actions:29, star-momentum-alert:69) because heartbeat's site is the smallest possible — a token-for-token substitution, not a 24h/7d/14d offset recomputation."
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "whatSection": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "whatHeading",
        "whatText"
      ]
    },
    "whatHeading": {
      "type": "Heading",
      "props": {
        "text": "What changed",
        "level": "h3"
      }
    },
    "whatText": {
      "type": "Text",
      "props": {
        "text": "skills/heartbeat/SKILL.md line 21: `$(date -u +%Y-%m-%d)` → `${today}`, with a parenthetical citing PR #63/#67 so a future cleanup doesn't drop the constraint."
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
