    "text_point_1": {
      "type": "Text",
      "props": {
        "text": "1/ An audit bot filed 27 security findings against an autonomous agent yesterday. Today, it authored three of the patches to close them.",
        "variant": "body"
      }
    },
    "text_point_2": {
      "type": "Text",
      "props": {
        "text": "2/ antfleet-ops opened Issue #184 on May 18 with 27 findings across the Aeon codebase. 3 Criticals. 9 Highs. 13 Mediums. 2 Lows. Everything from a Next.js loopback API exposed to the public internet, to POSIX-ERE patterns silently failing on every macOS operator.",
        "variant": "body"
      }
    },
    "text_point_3": {
      "type": "Text",
      "props": {
        "text": "3/ Aaron closed all 3 Criticals within 21 hours. Then antfleet-ops submitted PRs #194, #195, and #196 — the audit account itself writing the patches for H5, H8, and H2. Aeon fixed H6 in PR #197. All four merged the same day.",
        "variant": "body"
      }
    },
    "text_point_4": {
      "type": "Text",
      "props": {
        "text": "4/ 7 of 12 High-or-worse findings are now closed, 37 hours after the report was filed. The bot that wrote the findings is now a contributor to the repo it audited. This is what a self-repairing codebase looks like at scale.",
        "variant": "body"
      }
    },
    "stack_point_5": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
