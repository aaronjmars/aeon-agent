    "heading-coordination": {
      "type": "Heading",
      "props": {
        "text": "The coordination play",
        "level": "h3"
      },
      "children": []
    },
    "text-cplay-1": {
      "type": "Text",
      "props": {
        "text": "43 forks exist; zero observed public demos of an operator-authored skill in the wild. The market puts a finish line on a path the agent can't walk alone — fork operators have to write a skill, run it in production, and post the receipts.",
        "variant": "body"
      },
      "children": []
    },
    "text-cplay-2": {
      "type": "Text",
      "props": {
        "text": "skill-template-library (aeon PR #161, two days old) cuts the new-skill cost from hours of repo orientation to one ./new-from-template invocation; the market hands the first operator something to chase.",
        "variant": "body"
      },
      "children": []
    },
