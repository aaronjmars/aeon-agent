        "type": "warning",
        "message": "300⭐ milestone is 5 stars away — aeon at 295⭐ now (+11 in the last 24h)"
      },
      "children": []
    },
    "stats-section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat-current",
        "stat-distance"
      ]
    },
    "stat-current": {
      "type": "Stat",
      "props": {
        "label": "Current Stars",
        "value": "295",
        "delta": "+11",
        "trend": "up"
      },
      "children": []
    },
    "stat-distance": {
      "type": "Stat",
      "props": {
        "label": "Distance to 300⭐",
        "value": "5"
      },
      "children": []
    },
