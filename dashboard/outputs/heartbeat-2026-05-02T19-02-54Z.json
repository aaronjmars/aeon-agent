{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Heartbeat"
      },
      "children": [
        "heading",
        "separator1",
        "content_stack"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "PR #150: Shell-Injection Security Fix",
        "level": "h2"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "content_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "pr_link",
        "description",
        "metrics_row",
        "status_badges",
        "action_alert"
      ]
    },
    "pr_link": {
      "type": "StoryLink",
      "props": {
        "title": "PR #150 from tomscaria",
        "href": "https://github.com/aaronjmars/aeon/pull/150",
        "source": "GitHub"
      }
    },
    "description": {
      "type": "Text",
      "props": {
        "text": "Security fix: execFileSync for shell-injection on dashboard secrets. 3-line surgical fix.",
        "variant": "body"
      }
    },
    "metrics_row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat_time"
      ]
    },
    "stat_time": {
      "type": "Stat",
      "props": {
        "label": "Open for",
        "value": "25h"
      }
    },
    "status_badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge_security",
        "badge_no_review",
        "badge_no_label"
      ]
    },
    "badge_security": {
      "type": "Badge",
      "props": {
        "text": "Security Fix",
        "variant": "destructive"
      }
    },
    "badge_no_review": {
      "type": "Badge",
      "props": {
        "text": "No review comment",
        "variant": "outline"
      }
    },
    "badge_no_label": {
      "type": "Badge",
      "props": {
        "text": "No label",
        "variant": "outline"
      }
    },
    "action_alert": {
      "type": "Alert",
      "props": {
        "title": "Merge before stale",
        "message": "Worth a quick merge before it goes stale.",
        "type": "warning"
      }
    }
  }
}
