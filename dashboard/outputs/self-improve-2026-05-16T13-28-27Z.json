{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Agent Self-Improvement",
        "description": "2026-05-16"
      },
      "children": [
        "heading",
        "timeline-badge",
        "problem-section",
        "sep1",
        "cause-section",
        "sep2",
        "solution-section",
        "sep3",
        "what-changed-section",
