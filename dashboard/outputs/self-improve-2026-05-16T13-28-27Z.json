      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "token-report Social Pulse Fix",
        "level": "h2"
      }
    },
    "timeline-badge": {
      "type": "Badge",
      "props": {
        "text": "May 13–16, 5-day streak",
        "variant": "outline"
      }
    },
    "problem-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "problem-heading",
        "problem-text"
      ]
    },
    "problem-heading": {
      "type": "Heading",
      "props": {
        "text": "Problem",
        "level": "h3"
      }
    },
    "problem-text": {
      "type": "Text",
      "props": {
        "text": "token-report's Social Pulse step has been emitting \"XAI_API_KEY not set — no social data\" for five consecutive days (May 13–16) even though the key IS set and is being consumed by fetch-tweets / tweet-allocator prefetch every morning.",
        "variant": "body"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "cause-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "cause-heading",
        "cause-text",
        "cause-detail"
      ]
    },
    "cause-heading": {
      "type": "Heading",
      "props": {
        "text": "Root Cause",
        "level": "h3"
      }
    },
    "cause-text": {
      "type": "Text",
      "props": {
        "text": "The sandbox blocks $XAI_API_KEY expansion inside curl -H headers, so the direct-curl path in step 5 silently auth-fails and the skill misreads that as a missing key.",
        "variant": "body"
      }
    },
    "cause-detail": {
      "type": "Text",
      "props": {
        "text": "This is a known sandbox limitation already worked around for fetch-tweets / tweet-allocator / narrative-tracker — token-report was the last consumer still on the legacy direct-curl pattern.",
        "variant": "caption"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "solution-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "solution-heading",
        "solution-text",
        "solution-detail",
        "timing-detail"
      ]
    },
    "solution-heading": {
      "type": "Heading",
      "props": {
        "text": "Solution",
        "level": "h3"
      }
    },
    "solution-text": {
      "type": "Text",
      "props": {
        "text": "Replaced the broken curl with a sandbox-safe read of the most recent ## fetch-tweets section in memory/logs/.",
        "variant": "body"
      }
    },
    "solution-detail": {
      "type": "Text",
      "props": {
        "text": "Uses today's first, yesterday's as fallback. (token-report runs at 06:00 UTC, fetch-tweets at 06:30 UTC, so yesterday's is the typical source.)",
        "variant": "caption"
      }
    },
    "timing-detail": {
      "type": "Text",
      "props": {
        "text": "The Social Pulse section is now omitted entirely if no fetch-tweets log exists within 2 days, instead of lying about XAI_API_KEY.",
        "variant": "caption"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "what-changed-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "what-changed-heading",
        "file1",
        "file2",
        "file3"
      ]
    },
    "what-changed-heading": {
      "type": "Heading",
      "props": {
        "text": "What Changed",
        "level": "h3"
      }
    },
    "file1": {
      "type": "Text",
      "props": {
        "text": "skills/token-report/SKILL.md: step 5 rewritten to read fetch-tweets log instead of curl-ing XAI; step 6 Social Pulse template updated",
        "variant": "body"
      }
    },
    "file2": {
      "type": "Text",
      "props": {
        "text": "memory/logs/2026-05-16.md: updated",
        "variant": "body"
      }
    },
    "file3": {
      "type": "Text",
      "props": {
        "text": "memory/MEMORY.md: Open Improvement PRs index updated",
        "variant": "body"
      }
    },
    "sep4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "impact-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "impact-heading",
        "impact-text1",
        "impact-text2"
      ]
    },
    "impact-heading": {
      "type": "Heading",
      "props": {
        "text": "Impact",
        "level": "h3"
      }
    },
    "impact-text1": {
      "type": "Text",
      "props": {
        "text": "Stops the daily false \"key not set\" line in the most-read skill output.",
        "variant": "body"
      }
    },
    "impact-text2": {
      "type": "Text",
      "props": {
        "text": "Adds a real social signal (2-3 themes from logged tweets) on every run where fetch-tweets has produced output in the last 48h — which is every day under the current schedule.",
        "variant": "body"
      }
    },
    "sep5": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "pr-link": {
      "type": "StoryLink",
      "props": {
        "title": "PR #48: token-report Social Pulse Fix",
        "href": "https://github.com/aaronjmars/aeon-agent/pull/48",
        "source": "GitHub"
      }
    }
  }
}
