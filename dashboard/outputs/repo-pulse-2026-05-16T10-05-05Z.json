{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Repo Pulse",
        "description": "aaronjmars/minitor"
      },
      "children": [
        "stats-stack",
        "date-text",
        "sep1",
        "stargazers-stack"
      ]
    },
    "stats-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "stars-stat",
        "forks-stat"
      ]
    },
    "stars-stat": {
      "type": "Stat",
      "props": {
        "label": "Stars",
        "value": "9",
        "delta": "+1",
        "trend": "up"
      }
    },
    "forks-stat": {
      "type": "Stat",
      "props": {
        "label": "Forks",
        "value": "0",
        "delta": "+0",
        "trend": "neutral"
      }
    },
    "date-text": {
      "type": "Text",
      "props": {
        "text": "2026-05-16",
        "variant": "caption"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stargazers-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "stargazers-heading",
        "stargazer-link"
      ]
    },
    "stargazers-heading": {
      "type": "Heading",
      "props": {
        "text": "New stargazers (24h)",
        "level": "h3"
      }
    },
    "stargazer-link": {
      "type": "Link",
      "props": {
        "label": "github.com/alphamgmt",
        "href": "https://github.com/alphamgmt"
      }
    }
  }
}
