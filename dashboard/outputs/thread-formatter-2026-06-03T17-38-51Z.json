    "text_topic": {
      "type": "Text",
      "props": {
        "text": "Topic: ecosystem-entrants — weekly diff that flags new ECOSYSTEM.md arrivals (aeon PR #339)",
        "variant": "muted"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "text_p1": {
      "type": "Text",
      "props": {
        "text": "1/ Two projects were added to ECOSYSTEM.md 90 seconds apart on June 2. aeon shipped the skill to track exactly that today: a weekly diff that flags every new arrival before the week ends.",
        "variant": "body"
      }
    },
    "text_p2": {
      "type": "Text",
      "props": {
        "text": "2/ ECOSYSTEM.md is aeon's opt-in catalog of agent frameworks — any project can add a row. Until today there was no automated signal when rows appeared. The list grew silently.",
        "variant": "body"
      }
    },
    "text_p3": {
      "type": "Text",
      "props": {
        "text": "3/ ecosystem-entrants runs every Monday at 11:45 UTC. It diffs ECOSYSTEM.md against last week's snapshot, buckets rows into added/removed/updated, and traces new entries back to the PR that introduced them.",
        "variant": "body"
      }
    },
    "text_p4": {
      "type": "Text",
      "props": {
        "text": "4/ This pairs with ecosystem-pulse, which checks whether existing projects are still alive. Together: what arrived this week, and whether what was already there is still shipping.",
        "variant": "body"
      }
    },
    "text_p5": {
      "type": "Text",
      "props": {
        "text": "5/ The weekly arrival diff for ECOSYSTEM.md, 303 lines.",
        "variant": "body"
      }
    },
