{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "heartbeat"
      },
      "children": [
        "stack"
      ]
    },
    "stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "alert",
        "sep1",
        "impact_text",
        "affected_stack",
        "sep2",
        "action_heading",
        "action_intro",
        "scopes_stack",
        "repos_text",
        "secret_text",
        "sep3",
        "cadence_text"
      ]
    },
    "alert": {
      "type": "Alert",
      "props": {
        "title": "ESCALATION (21 days persistent — day 14→21 since last alert)",
        "message": "PAT with `workflows` scope still not configured",
        "type": "error"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "impact_text": {
      "type": "Text",
      "props": {
        "text": "Without it, aeon cannot push workflow file changes or write repository topics (admin-scope).",
        "variant": "body"
      }
    },
    "affected_stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge_workflow",
        "badge_topics"
      ]
    },
    "badge_workflow": {
      "type": "Badge",
      "props": {
        "text": "workflow file edits",
        "variant": "outline"
      }
    },
    "badge_topics": {
      "type": "Badge",
      "props": {
        "text": "topics API writes",
        "variant": "outline"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "action_heading": {
      "type": "Heading",
      "props": {
        "text": "Action Required",
        "level": "h3"
      }
    },
    "action_intro": {
      "type": "Text",
      "props": {
        "text": "Create a fine-grained PAT with the following scopes:",
        "variant": "body"
      }
    },
    "scopes_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "badge_contents",
        "badge_workflows",
        "badge_admin"
      ]
    },
    "badge_contents": {
      "type": "Badge",
      "props": {
        "text": "Contents: write",
        "variant": "secondary"
      }
    },
    "badge_workflows": {
      "type": "Badge",
      "props": {
        "text": "Workflows: write",
        "variant": "secondary"
      }
    },
    "badge_admin": {
      "type": "Badge",
      "props": {
        "text": "Administration: write",
        "variant": "secondary"
      }
    },
    "repos_text": {
      "type": "Text",
      "props": {
        "text": "Repositories: aaronjmars/aeon and aaronjmars/aeon-agent",
        "variant": "body"
      }
    },
    "secret_text": {
      "type": "Text",
      "props": {
        "text": "Add as GH_PAT repository secret",
        "variant": "body"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "cadence_text": {
      "type": "Text",
      "props": {
        "text": "Escalation cadence: every 7 days until resolved.",
        "variant": "body"
      }
    }
  }
}
