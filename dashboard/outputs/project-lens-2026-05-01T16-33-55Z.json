    "text-intro": {
      "type": "Text",
      "props": {
        "text": "The historical 'self-hosting' threshold — the moment a compiler can compile itself — has an agent-era twin: the moment an autonomous agent commits more code than its operators do. The piece argues the architectural reason this works isn't model strength; it's that Aeon's unit of labor is a Markdown file in a git repo, which makes every self-improvement a reviewable, revertable commit. The bottleneck moves from authorship to direction-setting — the same shift Lisp went through in 1962.",
        "variant": "body"
      }
    },
