{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "repo-article"
      },
      "children": [
        "heading",
        "separator1",
        "issue-section",
        "separator2",
        "impact-section",
        "separator3",
        "read-link"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "Yesterday The Audit Bot Filed Twenty-Seven Findings On Aeon. Today It Authored Three Of The Patches That Closed Them.",
        "level": "h2"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {}
    },
    "issue-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "issue-heading",
        "issue-details"
      ]
    },
    "issue-heading": {
      "type": "Heading",
      "props": {
        "text": "Issue #184 Findings",
        "level": "h3"
      }
    },
    "issue-details": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "filed-date",
        "findings-count",
        "severity-breakdown",
        "sha-note"
      ]
    },
    "filed-date": {
      "type": "Text",
      "props": {
        "text": "Filed: May 18 at 23:56 UTC"
      }
    },
    "findings-count": {
      "type": "Stat",
      "props": {
        "label": "Total Findings",
        "value": "27"
      }
    },
    "severity-breakdown": {
      "type": "Text",
      "props": {
        "text": "Severity breakdown: 3 Critical, 9 High"
      }
    },
    "sha-note": {
      "type": "Text",
      "props": {
        "text": "Each finding SHA-pinned to a public mirror",
        "variant": "caption"
      }
    },
    "separator2": {
      "type": "Separator",
      "props": {}
    },
    "impact-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "impact-heading",
        "patch-status",
        "antfleet-authorship",
        "stars-milestone"
      ]
    },
    "impact-heading": {
      "type": "Heading",
      "props": {
        "text": "Response & Impact",
        "level": "h3"
      }
    },
    "patch-status": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "timeline",
        "fixed-count"
      ]
    },
    "timeline": {
      "type": "Text",
      "props": {
        "text": "Timeline: 37 hours after filing"
      }
    },
    "fixed-count": {
      "type": "Stat",
      "props": {
        "label": "High-or-worse findings live on main",
        "value": "7",
        "delta": "of 12"
      }
    },
    "antfleet-authorship": {
      "type": "Stat",
      "props": {
        "label": "Merged PRs authored by AntFleet",
        "value": "3"
      }
    },
    "stars-milestone": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "stars-stat",
        "stars-breakdown",
        "stars-note"
      ]
    },
    "stars-stat": {
      "type": "Stat",
      "props": {
        "label": "Aeon organic stars",
        "value": "400"
      }
    },
    "stars-breakdown": {
      "type": "Text",
      "props": {
        "text": "v7: 103 stars, baseline: 6.9/day"
      }
    },
    "stars-note": {
      "type": "Text",
      "props": {
        "text": "First non-bootstrap milestone in project history",
        "variant": "lead"
      }
    },
    "separator3": {
      "type": "Separator",
      "props": {}
    },
    "read-link": {
      "type": "StoryLink",
      "props": {
        "title": "Read full article",
        "href": "https://github.com/aaronjmars/aeon-agent/blob/main/articles/repo-article-2026-05-20.md",
        "source": "GitHub"
      }
    }
  }
}
