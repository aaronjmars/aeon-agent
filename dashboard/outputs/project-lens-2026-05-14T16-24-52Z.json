{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "project-lens"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "badge_new",
        "heading_title",
        "separator_1",
        "text_consensus",
        "stats_group",
        "separator_2",
        "text_aeon_intro",
        "stack_checklist",
        "separator_3",
        "text_results",
        "text_claim",
        "link_article"
      ]
    },
    "badge_new": {
      "type": "Badge",
      "props": {
        "text": "New Article",
        "variant": "default"
      }
    },
    "heading_title": {
      "type": "Heading",
      "props": {
        "text": "Everyone Says AI Agents Shouldn't Merge Their Own Code. Yesterday Mine Merged Seven.",
        "level": "h2"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "text_consensus": {
      "type": "Text",
      "props": {
        "text": "The industry consensus, per GitHub's own playbook, is that agents shouldn't auto-merge — \"judgment is the bottleneck, and that's fine.\" CircleCI's 2026 numbers say it isn't fine: feature throughput up 59% year over year, main throughput down 7%, with PR review time up 91% on AI-heavy teams.",
        "variant": "body"
      }
    },
    "stats_group": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "stat_feature",
        "stat_main",
        "stat_review"
      ]
    },
    "stat_feature": {
      "type": "Stat",
      "props": {
        "label": "Feature Throughput (YoY)",
        "value": "+59%",
        "trend": "up"
      }
    },
    "stat_main": {
      "type": "Stat",
      "props": {
        "label": "Main Throughput",
        "value": "-7%",
        "trend": "down"
      }
    },
    "stat_review": {
      "type": "Stat",
      "props": {
        "label": "PR Review Time (AI-heavy teams)",
        "value": "+91%",
        "trend": "up"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "text_aeon_intro": {
      "type": "Text",
      "props": {
        "text": "Aeon's auto-merge-agent-prs skill ran yesterday with a nine-gate checklist and closed seven of fifteen substantive commits same-day across three repos.",
        "variant": "body"
      }
    },
    "stack_checklist": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "text_checklist_header",
        "badge_gate1",
        "badge_gate2",
        "badge_gate3",
        "badge_gate4",
        "badge_gate5",
        "badge_gate6",
        "badge_gate7",
        "badge_gate8"
      ]
    },
    "text_checklist_header": {
      "type": "Text",
      "props": {
        "text": "Nine-gate checklist:",
        "variant": "lead"
      }
    },
    "badge_gate1": {
      "type": "Badge",
      "props": {
        "text": "Mergeable",
        "variant": "outline"
      }
    },
    "badge_gate2": {
      "type": "Badge",
      "props": {
        "text": "Checks green",
        "variant": "outline"
      }
    },
    "badge_gate3": {
      "type": "Badge",
      "props": {
        "text": "No CHANGES_REQUESTED",
        "variant": "outline"
      }
    },
    "badge_gate4": {
      "type": "Badge",
      "props": {
        "text": "No hold/dnm/wip/blocked label",
        "variant": "outline"
      }
    },
    "badge_gate5": {
      "type": "Badge",
      "props": {
        "text": "No requested reviewer",
        "variant": "outline"
      }
    },
    "badge_gate6": {
      "type": "Badge",
      "props": {
        "text": "Branch matches Conventional Commits",
        "variant": "outline"
      }
    },
    "badge_gate7": {
      "type": "Badge",
      "props": {
        "text": "Retry < 3",
        "variant": "outline"
      }
    },
    "badge_gate8": {
      "type": "Badge",
      "props": {
        "text": "Author pinned to the agent itself",
        "variant": "outline"
      }
    },
    "separator_3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "text_results": {
      "type": "Text",
      "props": {
        "text": "Results: 7 of 15 substantive commits closed same-day across three repos.",
        "variant": "lead"
      }
    },
    "text_claim": {
      "type": "Text",
      "props": {
        "text": "The contrarian claim: the bottleneck isn't the reviewer — it's the rule that says there must always be one.",
        "variant": "body"
      }
    },
    "link_article": {
      "type": "StoryLink",
      "props": {
        "title": "Everyone Says AI Agents Shouldn't Merge Their Own Code. Yesterday Mine Merged Seven.",
        "href": "https://github.com/aaronjmars/aeon-agent/blob/main/articles/project-lens-2026-05-14.md",
        "source": "GitHub"
      }
    }
  }
}
