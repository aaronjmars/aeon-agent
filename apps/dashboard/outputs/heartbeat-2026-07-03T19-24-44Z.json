{
  "root": "card_root",
  "state": {},
  "elements": {
    "card_root": {
      "type": "Card",
      "props": {
        "title": "heartbeat"
      },
      "children": [
        "watch_status",
        "sep1",
        "memory_section",
        "sep2",
        "skills_section"
      ]
    },
    "watch_status": {
      "type": "Badge",
      "props": {
        "text": "🟡 WATCH",
        "variant": "outline"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "memory_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "memory_header",
        "memory_details"
      ]
    },
    "memory_header": {
      "type": "Text",
      "props": {
        "text": "🔵 MEMORY",
        "variant": "lead"
      }
    },
    "memory_details": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "security_alert",
        "pr_status",
        "confirmation"
      ]
    },
    "security_alert": {
      "type": "Alert",
      "props": {
        "title": "SECURITY.md Missing",
        "message": "minitor SECURITY.md still MISSING (HIGH)",
        "type": "error"
      }
    },
    "pr_status": {
      "type": "Text",
      "props": {
        "text": "No PR opened yet",
        "variant": "body"
      }
    },
    "confirmation": {
      "type": "Text",
      "props": {
        "text": "Confirmed 404 via MEMORY.md Next Priorities",
        "variant": "caption"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "skills_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "skills_header",
        "skills_metrics"
      ]
    },
    "skills_header": {
      "type": "Text",
      "props": {
        "text": "P0/P1/P3 clean",
        "variant": "lead"
      }
    },
    "skills_metrics": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "skills_stat",
        "prs_stat"
      ]
    },
    "skills_stat": {
      "type": "Stat",
      "props": {
        "label": "Enabled Skills",
        "value": "7",
        "delta": "all green",
        "trend": "up"
      }
    },
    "prs_stat": {
      "type": "Stat",
      "props": {
        "label": "Open PRs",
        "value": "0",
        "trend": "neutral"
      }
    }
  }
}
