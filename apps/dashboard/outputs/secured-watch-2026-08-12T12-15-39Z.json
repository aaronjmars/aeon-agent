    "repo1_severity": {
      "type": "Badge",
      "props": {
        "text": "HIGH",
        "variant": "destructive"
      }
    },
    "repo1_stars": {
      "type": "Text",
      "props": {
        "text": "46,821★",
        "variant": "caption"
      }
    },
    "repo1_date": {
      "type": "Text",
      "props": {
        "text": "fixed upstream Jul 8, 2026",
        "variant": "caption"
      }
