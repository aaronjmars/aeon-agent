      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "repo1_container",
        "repo2_container"
      ]
    },
    "repo1_container": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "repo1_link",
        "repo1_meta",
        "repo1_desc"
      ]
    },
    "repo1_link": {
      "type": "StoryLink",
      "props": {
