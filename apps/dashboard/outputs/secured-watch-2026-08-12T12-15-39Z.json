{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Secured by Aeon",
        "description": "Vulnerability monitoring and remediation"
      },
      "children": [
        "heading_main",
        "summary_stack",
        "sep1",
        "section_new",
        "repos_stack"
      ]
    },
    "heading_main": {
      "type": "Heading",
      "props": {
        "text": "Secured by Aeon — new since last check ⭐",
        "level": "h2"
      }
    },
    "summary_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "text_summary",
        "stats_row"
      ]
    },
    "text_summary": {
      "type": "Text",
      "props": {
        "text": "2 more repos just got the vuln-scanner treatment.",
        "variant": "lead"
      }
    },
    "stats_row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat_repos",
        "stat_stars"
      ]
    },
    "stat_repos": {
      "type": "Stat",
      "props": {
        "label": "Repos secured",
        "value": "72",
        "delta": "+2",
        "trend": "up"
      }
    },
    "stat_stars": {
      "type": "Stat",
      "props": {
        "label": "Total stars",
        "value": "2,144,668",
        "delta": "+73,895",
        "trend": "up"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section_new": {
      "type": "Heading",
      "props": {
        "text": "🆕 Newly secured (2)",
        "level": "h3"
      }
    },
    "repos_stack": {
