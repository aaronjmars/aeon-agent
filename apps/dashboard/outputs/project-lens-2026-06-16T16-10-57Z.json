    "landscape-heading": {
      "type": "Heading",
      "props": {
        "text": "The Marketplace Landscape",
        "level": "h3"
      }
    },
    "landscape-text": {
      "type": "Text",
      "props": {
        "text": "Eight agent-skill marketplaces sprang up by Q2 2026 — all racing on discovery while Snyk's ToxicSkills audit found prompt injection across 3,984 skills that scanners can't catch, because the payload is prose, not code."
      }
    },
