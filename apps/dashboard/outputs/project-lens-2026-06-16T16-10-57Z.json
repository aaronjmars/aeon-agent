        "aeon-tension"
      ]
    },
    "aeon-heading": {
      "type": "Heading",
      "props": {
        "text": "Aeon's Alternative: Trust via Version Control",
        "level": "h3"
      }
    },
    "aeon-text": {
      "type": "Text",
      "props": {
        "text": "The piece argues Aeon took the opposite route this week: no store. A community pack installs as a pull request into your own fork (#487/#486/#491), so the trust primitive is a revertable, blamable commit in your git history, not a platform's pre-publish scan."
      }
    },
    "aeon-tension": {
      "type": "Text",
      "props": {
        "text": "It stays honest about the tension — zero-touch auto-merge (#485) means the diff gets recorded but not read, so git buys you forensics after a breach, not prevention before one."
      }
    }
