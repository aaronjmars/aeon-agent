{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Repo Pulse"
      },
      "children": [
        "header-stack",
        "repo-stats-stack",
        "separator1",
        "stargazers-stack",
        "separator2",
        "source-text"
      ]
    },
    "header-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "date-text",
        "status-badge"
      ]
    },
    "date-text": {
      "type": "Text",
      "props": {
        "text": "2026-06-23",
        "variant": "muted"
      },
      "children": []
    },
    "status-badge": {
      "type": "Badge",
      "props": {
        "text": "STEADY",
        "variant": "default"
      },
      "children": []
    },
    "repo-stats-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "repo-link",
        "stats-row"
      ]
    },
    "repo-link": {
      "type": "StoryLink",
      "props": {
        "title": "aaronjmars/aeon",
        "href": "https://github.com/aaronjmars/aeon",
        "source": "GitHub"
      },
      "children": []
    },
    "stats-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat-stars",
        "stat-forks"
      ]
    },
    "stat-stars": {
      "type": "Stat",
      "props": {
        "label": "Stars",
        "value": "543",
        "delta": "+1",
        "trend": "up"
      },
      "children": []
    },
    "stat-forks": {
      "type": "Stat",
      "props": {
        "label": "Forks",
        "value": "188",
        "delta": "+1",
        "trend": "up"
      },
      "children": []
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "stargazers-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "stargazers-heading",
        "stargazer-link"
      ]
    },
    "stargazers-heading": {
      "type": "Heading",
      "props": {
        "text": "Other new stargazers:",
        "level": "h4"
      },
      "children": []
    },
    "stargazer-link": {
      "type": "Link",
      "props": {
        "label": "github.com/terryzhouke",
        "href": "https://github.com/terryzhouke"
      },
      "children": []
    },
    "separator2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "source-text": {
      "type": "Text",
      "props": {
        "text": "Source: events",
        "variant": "caption"
      },
      "children": []
    }
  }
}
