{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Changelog (push-to)",
        "description": "2026-09-21"
      },
      "children": [
        "stack-content"
      ]
    },
    "stack-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "repos-text",
        "prs-stat",
        "sep-1",
        "entry-section",
        "pr-link"
      ]
    },
    "repos-text": {
      "type": "Text",
      "props": {
        "text": "aeonfun/aeon → aaronjmars/aeon-website",
        "variant": "muted"
      }
    },
    "prs-stat": {
      "type": "Stat",
      "props": {
        "label": "New PRs consolidated",
        "value": "8"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
