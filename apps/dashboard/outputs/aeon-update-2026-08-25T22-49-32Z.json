      },
      "children": [
        "status-row",
        "sep-1",
        "pr-link",
        "sep-2",
        "stats-row",
        "sep-3",
        "headline-section",
        "sep-4",
        "commit-info",
        "sep-5",
        "needs-section",
        "sep-6",
        "messages-section"
      ]
    },
    "status-row": {
      "type": "Stack",
