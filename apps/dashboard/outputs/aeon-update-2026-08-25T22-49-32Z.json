      }
    },
    "stat-files": {
      "type": "Stat",
      "props": {
        "label": "Files applied",
        "value": "51"
      }
    },
    "stat-add": {
      "type": "Stat",
      "props": {
        "label": "Added",
        "value": "10"
      }
    },
    "stat-update": {
      "type": "Stat",
      "props": {
        "label": "Updated",
        "value": "36"
      }
    },
    "stat-merge": {
      "type": "Stat",
      "props": {
        "label": "Auto-merged",
        "value": "5"
      }
    },
