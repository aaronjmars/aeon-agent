    "repo-badge": {
      "type": "Badge",
      "props": {
        "text": "aeonfun/aeon",
        "variant": "secondary"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
