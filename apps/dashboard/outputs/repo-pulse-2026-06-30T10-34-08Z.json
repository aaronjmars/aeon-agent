{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Repo Pulse — 2026-06-30"
      },
      "children": [
        "main_stack"
      ]
    },
    "main_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "status_badge",
        "repo_stats",
        "sep1",
        "stargazers_section",
        "sep2",
        "forks_section",
        "sep3",
        "source"
      ]
    },
    "status_badge": {
      "type": "Badge",
      "props": {
        "text": "STEADY",
        "variant": "default"
      }
    },
    "repo_stats": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "repo_name",
        "stats_row"
      ]
    },
    "repo_name": {
      "type": "Text",
      "props": {
        "text": "aaronjmars/aeon",
        "variant": "lead"
      }
    },
    "stats_row": {
