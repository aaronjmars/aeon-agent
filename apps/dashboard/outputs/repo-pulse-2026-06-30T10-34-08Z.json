        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stars_stat",
        "forks_stat"
      ]
    },
    "stars_stat": {
      "type": "Stat",
      "props": {
        "label": "stars",
        "value": "560",
        "delta": "+1",
        "trend": "up"
      }
    },
    "forks_stat": {
      "type": "Stat",
      "props": {
        "label": "forks",
        "value": "196",
        "delta": "+2",
        "trend": "up"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stargazers_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
