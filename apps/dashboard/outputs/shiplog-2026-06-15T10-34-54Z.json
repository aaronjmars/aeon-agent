{
  "root": "card_shiplog",
  "state": {},
  "elements": {
    "card_shiplog": {
      "type": "Card",
      "props": {
        "title": "Shiplog — 2026-06-15"
      },
      "children": [
        "summary_text",
        "sep_1",
        "themes_section",
        "sep_2",
        "metrics_section",
        "sep_3",
        "link_section"
      ]
    },
    "summary_text": {
      "type": "Text",
      "props": {
        "text": "Aeon stopped requiring an Anthropic key to run, rebuilt the clone-to-first-run path around time-to-first-launch, and watched six outside contributors merge onchain skills into the registry.",
        "variant": "body"
      }
    },
    "sep_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "themes_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "themes_heading",
        "themes_list"
      ]
    },
    "themes_heading": {
      "type": "Heading",
      "props": {
        "text": "Themes",
        "level": "h3"
      }
    },
    "themes_list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "theme_1",
        "theme_2",
        "theme_3"
      ]
    },
    "theme_1": {
      "type": "Text",
      "props": {
        "text": "Run Aeon on any LLM key you already have (multi-provider gateway + failover)",
        "variant": "body"
      }
    },
    "theme_2": {
      "type": "Text",
      "props": {
        "text": "The clone-to-first-run onboarding path got rebuilt",
        "variant": "body"
      }
    },
    "theme_3": {
      "type": "Text",
      "props": {
        "text": "Outside contributors are shipping onchain skills",
        "variant": "body"
      }
    },
    "sep_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "metrics_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "metrics_heading",
        "metrics_grid"
      ]
    },
    "metrics_heading": {
      "type": "Heading",
      "props": {
        "text": "Metrics",
        "level": "h3"
      }
    },
    "metrics_grid": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "stat_commits",
        "stat_prs",
        "stat_lines"
      ]
    },
    "stat_commits": {
      "type": "Stat",
      "props": {
        "label": "Commits",
        "value": "113"
      }
    },
    "stat_prs": {
      "type": "Stat",
      "props": {
        "label": "PRs Merged",
        "value": "98"
      }
    },
    "stat_lines": {
      "type": "Stat",
      "props": {
        "label": "Lines Changed",
        "value": "+12k / −4.8k"
      }
    },
    "sep_3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "link_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "link_article"
      ]
    },
    "link_article": {
      "type": "StoryLink",
      "props": {
        "title": "Full Shiplog Article",
        "href": "https://github.com/aaronjmars/aeon-agent/blob/main/articles/shiplog-2026-06-15.md",
        "source": "GitHub"
      }
    }
