    "intro-section": {
      "type": "Text",
      "props": {
        "text": "The A2A gateway lets any agent framework — LangChain, AutoGen, CrewAI, OpenAI Agents SDK — call an Aeon skill over plain HTTP. The server shipped with working code and four example clients but no README. Now `apps/a2a-server/` has one: what it is, how to start it, every endpoint, and a copy-paste client."
      }
    },
