# macOS
.DS_Store

# Secrets & local env
.env
.env.local
.env.*.local

# Claude Code local state
.claude/

# Caches — prefetch scripts write these, skills read them; regenerated every run
# (.xai-cache, .treasury-cache, .star-cache, .github-releases-cache, …)
.*-cache/
.tg_cache/

# Working scratch dirs some skills stage during a run, then clean up:
# .pending-notify (notify re-delivery), .pending-deploy (deploy-prototype build),
# plus .pending-notify-temp where skills stage notify bodies for `./notify -f`
.pending-*/

# Generated helper scripts — copied to the repo root at runtime from scripts/*.sh
# and removed before the run commits. Ignored so a missed cleanup never commits them.
/notify
/notify-jsonrender
/secretcurl

# Legacy transient run artifacts (pre-v0.1.0 skills leaked these to the root).
# The current engine no longer writes them; ignored defensively so they can't recur.
.outputs/
.notify-*.md
.*-notify.md
.tweet-digest-*.md
.pending-*.md

# Skill provenance lock (per-repo, not committed)
skills.lock

# Scratch / temp files
tmp_*
*.tmp
.tmp-*
.pending-*.sh
.run-*.sh
.*-tmp.md
.*-draft.md
.*-msg.txt
*_msg.txt
*_raw.txt

# Leaked creds scratch
.xai_key
.ghtoken

# Python bytecode
__pycache__/
*.pyc

# Node
node_modules/

# Stale artifacts
.external-work
.vuln-scan/

# Shiplog skill temp XAI payloads and response files
xai-shiplog-*.json
